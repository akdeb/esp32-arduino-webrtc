# Copy to .env (gitignored) and fill in. PlatformIO builds read these; real environment variables win.
WIFI_SSID=
WIFI_PASSWORD=
OPENAI_API_KEY=
# Optional. Male: meridian, vesper, stone, ripple, cinder. Female: gleam, quartz, willow, delta.
OPENAI_VOICE=
# Optional speaker volume, 0..100 (default 100).
VOLUME=
